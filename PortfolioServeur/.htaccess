# Désactiver le listage des fichiers du dossier (empêche de voir le contenu du dossier)
Options -Indexes

# Interdire l'accès direct au fichier de configuration
<Files "config.php">
    Require all denied
</Files>

# Interdire l'accès aux fichiers du dépôt Git qui ne font pas partie du site
<FilesMatch "^(README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
